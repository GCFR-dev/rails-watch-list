<h1><%= @list.name %></h1>
<% @list.bookmarks.each do |bookmark| %>
  <p>
    <%= bookmark.movie.title %> : <%= bookmark.comment %>
    <%= link_to "Supprimer", bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "Supprimer ce film de la liste ?" } %>
  </p>
<% end %>

<%= link_to "Ajouter un film", new_list_bookmark_path(@list), class: "btn btn-primary" %>
<%= link_to "Retour aux listes", lists_path %>
